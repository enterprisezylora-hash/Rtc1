NODE_ENV=production
PORT=8787
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-sb-publishable-key
SUPABASE_SECRET_KEY=replace-with-sb-secret-key
# Optional backward compatibility aliases
SUPABASE_SERVICE_ROLE_KEY=replace-with-sb-secret-key
SUPABASE_ANON_KEY=replace-with-sb-publishable-key

# Device subscriber identity (for server/rco-device-subscriber.js)
RCO_DEVICE_EXTERNAL_ID=device-001
RCO_DEVICE_DISPLAY_NAME=Sample Device
RCO_DEVICE_PLATFORM=android

SUPABASE_STORAGE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=ap-northeast-1
SUPABASE_STORAGE_ACCESS_KEY=replace-with-access-key
SUPABASE_STORAGE_SECRET_KEY=replace-with-secret-key
SUPABASE_STORAGE_BUCKET=media
SUPABASE_STORAGE_PUBLIC_BASE_URL=

# Redis layer (queue mirror + cache + pubsub)
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_CLUSTER_CHANNEL=rco:cluster:events
REDIS_STATUS_CHANNEL=rco:status:events
REDIS_COMMAND_STREAM=rco:commands:stream
REDIS_COMMAND_LIST=rco:commands:list
REDIS_SNAPSHOT_CACHE_KEY=rco:cache:snapshot
REDIS_HEALTH_CACHE_KEY=rco:cache:health
REDIS_CACHE_TTL_SECONDS=3
INSTANCE_ID=server-a
